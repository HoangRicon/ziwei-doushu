# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local example: postgresql://postgres:password@localhost:5432/ziwei_saas
# Remote: postgresql://user:password@host:5432/database
DATABASE_URL="postgresql://postgres:123456@localhost:5432/tuviannam?schema=public"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── Google OAuth ───────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── AI Provider (existing) ────────────────────────────────────────────────
AI_PROVIDER=custom
MIMO_BASE_URL=http://localhost:20128/v1
MIMO_API_KEY=sk-your-api-key
MIMO_MODEL=cx/gpt-5.4-mini

# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── SEO Verification (existing) ───────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=808FFC6023A2C359B375DD860FEDA856
NEXT_PUBLIC_BAIDU_VERIFICATION=
NEXT_PUBLIC_360_VERIFICATION=
